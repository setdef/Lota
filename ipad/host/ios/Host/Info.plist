  SPDX-License-Identifier: AGPL-3.0-or-later

  The iOS kit's Info.plist, which ipad/prepare.rb fills in and fledge.yml's
  ios host lays over Fledge's (Fledge 0.5.0, ADR 025). It starts from
  Fledge's examples/sdl_phone copy: the scene's delegate is SDL's
  SDLUIKitSceneDelegate, which SDL_RunApp in Host/main.m expects.

  What the kit adds for a game:
  - CFBundleDisplayName, the name under the icon, is the target's
    APP_DISPLAY_NAME build setting, so it may hold spaces and any
    character the target's name cannot.
  - UILaunchScreen, empty, so iOS runs the app at the screen's own size
    rather than letterboxed.
  - UIApplicationSupportsIndirectInputEvents, which SDL asks for to read a
    mouse or trackpad ("You need UIApplicationSupportsIndirectInputEvents
    in your Info.plist for mouse support" without it).
  - UIStatusBarHidden with UIViewControllerBasedStatusBarAppearance false,
    when the workflow's hide_status_bar is true: the status bar stays
    hidden, as a game's is, whatever SDL's view controller would prefer.
  - The orientations the workflow's orientations input names.
  - LotaAudioSessionCategory, which Host/main.m reads: the audio session's
    category, set before SDL and OpenAL open the audio device.
  UIRequiresFullScreen stays unset, so iPadOS may show the game beside
  other apps.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
@KIT_STATUS_BAR@	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>LotaAudioSessionCategory</key>
	<string>@KIT_AUDIO_CATEGORY@</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
					<key>UISceneDelegateClassName</key>
					<string>SDLUIKitSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
@KIT_ORIENTATIONS_IPHONE@	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
@KIT_ORIENTATIONS_IPAD@	</array>
</dict>
</plist>
