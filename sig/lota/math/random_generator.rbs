module Lota
  module Math
    class RandomGenerator < Object[Native::RandomGenerator]
      private def self.from_native: (Native::RandomGenerator native) -> RandomGenerator

      def self.new: (?(Float | Integer)? low, ?(Float | Integer)? high) -> RandomGenerator

      def random: (?(Float | Integer)? min, ?(Float | Integer)? max) -> (Float | Integer)

      def random_normal: (?(Float | Integer)? stddev, ?(Float | Integer)? mean) -> Float

      def seed=: (Float | Integer | Array[(Float | Integer)?] seed) -> void

      def seed: () -> [Integer, Integer]

      def state: () -> String

      def state=: (String state) -> void

      private def self.number: (::Object? value) -> (Float | Integer)
    end
  end
end
