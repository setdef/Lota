module Lota
  class Archive
    class Refused < RuntimeError
    end

    type entry = [String, Symbol?]

    NATIVE: Regexp

    FORBIDDEN: Regexp

    RESERVED: Regexp

    FILE_PATH_LIMIT: Integer

    FOLDER_PATH_LIMIT: Integer

    RECORD: String

    RECORD_HEADER: String

    attr_reader path: String

    self.@unpacked: Hash[String, String]

    def self.unpacked: (String source) -> String?

    private def self.remember: (String source, String folder) -> void

    def self.cache_directory: (String os, RBS::Unnamed::ENVClass | Hash[String, String] env, String home) -> String

    def initialize: (String path) -> void

    def unpack: (String cache, ?windows: bool) -> String

    private def unpack_into: (String cache, bool windows) -> String

    def check: (Array[entry] entries, String destination, ?path_limit: bool) -> nil

    private def refusal: (String name, Symbol? type) -> String?

    private def length_refusal: (String path, Symbol? type) -> String?

    private def long_paths?: (String folder) -> bool

    private def walk: (String folder) -> Array[entry]

    private def write: (Array[entry] entries, String destination) -> void

    private def record: (String digest, Array[entry] entries, String game) -> String

    private def whole?: (String folder, String digest) -> bool

    private def settle: (String temporary, String folder, String digest) -> void
  end
end
