module Lota
  module Graphics
    def self.canvas=: (Texture? canvas) -> void

    def self.clear: (*(Float | Integer) color) -> nil

    def self.readback_texture: (Texture texture) -> Lota::Image::ImageData

    def self.active?: () -> bool

    def self.created?: () -> bool

    def self.reset: () -> nil

    def self.origin: () -> nil

    def self.push: (?(Symbol | String)? stack) -> nil
                 | [T] (?(Symbol | String)? stack) { () -> T } -> T

    def self.pop: () -> nil

    def self.translate: (Float | Integer x, Float | Integer y) -> nil

    def self.scale: (?(Float | Integer) sx, ?(Float | Integer)? sy) -> nil

    def self.shear: (Float | Integer kx, Float | Integer ky) -> nil

    def self.background_color: () -> Array[Float]

    def self.present: () -> nil

    def self.width: () -> Integer

    def self.height: () -> Integer

    def self.dimensions: () -> Array[Integer]

    def self.color=: (Array[Float | Integer] color) -> void

    def self.color: () -> Array[Float]

    def self.line_width=: (Float | Integer width) -> void

    def self.line_width: () -> Float

    def self.line_style=: (Symbol | String style) -> void

    def self.line_style: () -> Symbol

    def self.rectangle: ((Symbol | String) mode, Float | Integer x, Float | Integer y, Float | Integer width, Float | Integer height, ?(Float | Integer)? rx, ?(Float | Integer)? ry, ?Integer? segments) -> nil

    def self.circle: ((Symbol | String) mode, Float | Integer x, Float | Integer y, Float | Integer radius, ?Integer? segments) -> nil

    def self.ellipse: ((Symbol | String) mode, Float | Integer x, Float | Integer y, Float | Integer radius_x, ?(Float | Integer)? radius_y, ?Integer? segments) -> nil

    def self.arc: ((Symbol | String) drawmode, *(Symbol | String | Float | Integer | nil) arguments) -> nil

    def self.line: (*(Float | Integer | Array[Float | Integer]) points) -> nil

    def self.draw: (Texture | SpriteBatch drawable, ?(Quad | Float | Integer)? quad, ?(Float | Integer)? x, ?(Float | Integer)? y, ?(Float | Integer)? r, ?(Float | Integer)? sx, ?(Float | Integer)? sy, ?(Float | Integer)? ox, ?(Float | Integer)? oy, ?(Float | Integer)? kx, ?(Float | Integer)? ky) -> nil

    type text = String | Array[String | Array[Float | Integer]]

    def self.font=: (Font font) -> void

    def self.font: () -> Font

    def self.print: (text text, ?(Font | Float | Integer)? font, ?(Float | Integer)? x, ?(Float | Integer)? y, ?(Float | Integer)? r, ?(Float | Integer)? sx, ?(Float | Integer)? sy, ?(Float | Integer)? ox, ?(Float | Integer)? oy, ?(Float | Integer)? kx, ?(Float | Integer)? ky) -> nil

    def self.printf: (text text, Font | Float | Integer font, Float | Integer x, Float | Integer y, ?(Float | Integer | Symbol | String)? limit, ?(Symbol | String | Float | Integer)? align, ?(Float | Integer)? r, ?(Float | Integer)? sx, ?(Float | Integer)? sy, ?(Float | Integer)? ox, ?(Float | Integer)? oy, ?(Float | Integer)? kx, ?(Float | Integer)? ky) -> nil

    private def self.number: (::Object? value) -> (Float | Integer)

    private def self.optional_number: (::Object? value) -> (Float | Integer)?

    private def self.alignment: (::Object? value) -> String?

    private def self.colored_text: (text text) -> Array[[String, Float | Integer, Float | Integer, Float | Integer, Float | Integer]]

    private def self.placement: (Float | Integer x, Float | Integer y, (Float | Integer)? r, (Float | Integer)? sx, (Float | Integer)? sy, (Float | Integer)? ox, (Float | Integer)? oy, (Float | Integer)? kx, (Float | Integer)? ky) -> Array[Float | Integer]

    def self.placement_after: ((Quad | Float | Integer)? quad, (Float | Integer)? x, (Float | Integer)? y, (Float | Integer)? r, (Float | Integer)? sx, (Float | Integer)? sy, (Float | Integer)? ox, (Float | Integer)? oy, (Float | Integer)? kx, (Float | Integer)? ky) -> Array[Float | Integer]

    def self.default_filter=: (Symbol | String | Array[Symbol | String | Integer | Float] filter) -> void

    def self.default_filter: () -> [Symbol, Symbol, Integer]

    def self.background_color=: (Array[Float | Integer] color) -> void

    def self.blend_mode=: (Symbol | String | Array[Symbol | String] mode) -> void

    def self.blend_mode: () -> Array[Symbol]

    def self.canvas: () -> Texture?

    def self.color_mask=: (bool | Array[bool] | nil mask) -> void

    def self.color_mask: () -> [bool, bool, bool, bool]

    def self.depth_mode=: ([Symbol | String, bool] | nil mode) -> void

    def self.depth_mode: () -> [Symbol, bool]

    def self.front_face_winding=: (Symbol | String winding) -> void

    def self.front_face_winding: () -> Symbol

    def self.line_join=: (Symbol | String join) -> void

    def self.line_join: () -> Symbol

    def self.mesh_cull_mode=: (Symbol | String mode) -> void

    def self.mesh_cull_mode: () -> Symbol

    def self.point_size=: (Float | Integer size) -> void

    def self.point_size: () -> Float

    def self.scissor=: (Array[Float | Integer] | nil rect) -> void

    def self.scissor: () -> Array[Float]

    def self.intersect_scissor: (Float | Integer x, Float | Integer y, Float | Integer width, Float | Integer height) -> nil

    def self.stack_depth: () -> Integer

    def self.stencil_state=: (Array[Symbol | String | Float | Integer] | nil state) -> void

    def self.stencil_state: () -> Array[Symbol | Integer]

    def self.gamma_correct?: () -> bool

    def self.wireframe=: (bool enable) -> void

    def self.wireframe?: () -> bool

    def self.renderer_info: () -> [String, String, String, String]

    def self.points: (*(Float | Integer | Array[Float | Integer]) points) -> nil

    def self.polygon: ((Symbol | String) mode, *(Float | Integer | Array[Float | Integer]) vertices) -> nil

    private def self.coordinates: (Array[Float | Integer | Array[Float | Integer]] values) -> Array[Float | Integer]

    private def self.integer: (::Object? value) -> Integer
  end
end
