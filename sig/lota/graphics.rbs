module Lota
  module Graphics
    def self.canvas=: (Texture? canvas) -> void

    def self.clear: (*(Float | Integer) color) -> nil

    def self.readback_texture: (Texture texture) -> Image::ImageData

    def self.active?: () -> bool

    def self.origin: () -> nil

    def self.background_color: () -> Array[Float]

    def self.present: () -> nil

    def self.width: () -> Integer

    def self.height: () -> Integer

    def self.dimensions: () -> Array[Integer]
  end
end
