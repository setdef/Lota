module Lota
  module Restart
    type value = Variant::value

    interface _Environment
      def delete: (String name) -> String?
    end

    VARIABLE: String

    MAXIMUM_LENGTH: Integer

    MAXIMUM_DEPTH: Integer

    class Unsupported < TypeError
    end

    self.@value: value

    self.@taken: bool

    self.@command: Array[String]?

    self.@directory: String?

    self.@pending: String?

    self.@installed: bool?

    self.@arguments: Array[String]

    self.@fused: bool

    private def self.value: () -> value

    private def self.encode: (Variant::carried value) -> String

    private def self.decode: (String text) -> value

    private def self.take: (?_Environment environment) -> void

    private def self.remember: (Array[String] arguments, ?fused: bool) -> void

    private def self.restartable?: () -> bool

    private def self.request: (Variant::carried value) -> String

    private def self.fused_command: (String program) -> Array[String]?

    private def self.exec_pending: () -> void

    private def self.written: (Variant::carried value, Array[Array[Variant::carried] | Hash[Variant::carried, Variant::carried]] outer) -> String

    private def self.table: (Array[[Variant::carried, Variant::carried]] pairs, Array[Variant::carried] | Hash[Variant::carried, Variant::carried] value, Array[Array[Variant::carried] | Hash[Variant::carried, Variant::carried]] outer) -> String

    private def self.read: (StringScanner scanner, Integer depth, Array[Variant::token] tokens) -> void

    private def self.pairs: (StringScanner scanner, Integer depth, Array[Variant::token] tokens) -> void

    private def self.expect: (StringScanner scanner, Regexp delimiter) -> void

    private def self.install: () -> void

  end
end

module Kernel
  def self?.exec: (Hash[string, string?] env, [String, String] command, *String args, ?chdir: String) -> bot
                | ...
end
