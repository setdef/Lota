      def bounding_box: (?Integer child_index) -> Array[Float]

      def compute_mass: (Float | Integer density) -> Array[Float]

      def mass_data: () -> Array[Float]

      def ray_cast: (Array[Float | Integer] ray, Array[Float | Integer] rest) -> Array[Float]

      def set_user_data: (::Object? value) -> nil

      def user_data: () -> ::Object?
    end

