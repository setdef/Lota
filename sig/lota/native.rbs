      def self.cpp_class: () -> String

      def object_type: () -> String

      def type_of?: (String name) -> bool

      def anchors: () -> Array[Float]

      def reaction_force: (Float | Integer dt) -> Array[Float]

      def set_user_data: (::Object? value) -> nil

