    module Physics
      def self.open: () -> nil

      def self.open?: () -> bool

      def self.new_circle_shape: (Body body, Float | Integer x, Float | Integer y, Float | Integer radius) -> CircleShape

      def self.new_rectangle_shape: (Body body, Array[Float | Integer] placement) -> PolygonShape

