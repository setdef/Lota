    module Physics
      def self.open: () -> nil

      def self.open?: () -> bool

      def self.new_circle_shape: (Body body, Float | Integer x, Float | Integer y, Float | Integer radius) -> CircleShape

      def self.new_rectangle_shape: (Body body, Array[Float | Integer] placement) -> PolygonShape

      def self.new_edge_shape: (Body body, Array[Float | Integer] coordinates) -> EdgeShape

      def self.new_polygon_shape: (Body body, Array[Float | Integer] coordinates) -> PolygonShape

      def self.new_chain_shape: (Body body, bool loop, Array[Float | Integer] coordinates) -> ChainShape

      def self.new_revolute_joint: (Body body1, Body body2, Array[Float | Integer] anchors, bool collide_connected, ?(Float | Integer)? reference_angle) -> RevoluteJoint

      def self.new_friction_joint: (Body body1, Body body2, Array[Float | Integer] anchors, bool collide_connected) -> FrictionJoint

      def self.new_weld_joint: (Body body1, Body body2, Array[Float | Integer] anchors, bool collide_connected, ?(Float | Integer)? reference_angle) -> WeldJoint

