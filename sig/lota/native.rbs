      end
    end

    module System
      def self.open: () -> nil

      def self.open?: () -> bool
    end

    module Touch
      def self.set_trackpad_touch: (bool enable) -> nil
    end

    module Window
      def self.open: () -> nil

      def self.open?: () -> bool

      def self.set_mode: (Integer width, Integer height, WindowSettings? settings) -> bool

      def self.get_window: (WindowSettings settings) -> [Integer, Integer]

      def self.fullscreen_types: () -> Array[String]

      def self.set_high_dpi_allowed: (bool enable) -> nil

      def self.show_message_box: (String title, String message, ?String? type, ?bool attachtowindow) -> bool

      def self.show_message_box_with_buttons: (String title, String message, Array[String] buttons, ?Integer? enterbutton, ?Integer? escapebutton, ?String? type, ?bool attachtowindow) -> Integer
    end

    module Graphics
      def self.open: () -> nil

      def self.open?: () -> bool

      def self.set_gamma_correct: (bool gamma_correct) -> nil

      def self.set_low_power_preferred: (bool preferred) -> nil

      def self.default_renderers: () -> Array[String]

      def self.set_renderers: (Array[String] names) -> nil

      def self.push: (?String? stack, ?Transform? transform) -> nil

      def self.apply_transform: (Transform transform) -> nil

      def self.apply_placement: (Array[Float | Integer] placement) -> nil

      def self.replace_transform: (Transform transform) -> nil

      def self.replace_placement: (Array[Float | Integer] placement) -> nil

      def self.transform_point: (Float | Integer x, Float | Integer y) -> [Float, Float]

      def self.inverse_transform_point: (Float | Integer x, Float | Integer y) -> [Float, Float]

      def self.set_projection: (Transform transform) -> nil

      def self.set_projection_matrix: (String? layout, Array[Float | Integer] elements) -> nil

      def self.present: () -> nil

      def self.new_canvas: (Integer? width, Integer? height, Integer? msaa) -> Texture

      def self.new_texture_from_data: (Data data, bool canvas) -> Texture

      def self.new_texture_from_image_data: (ImageData data, bool canvas) -> Texture

      def self.set_canvas: (Texture texture) -> nil

      def self.reset_canvas: () -> nil

      def self.clear: (Float | Integer red, Float | Integer green, Float | Integer blue, Float | Integer alpha) -> nil

      def self.readback_texture: (Texture texture) -> ImageData

      def self.set_color: (Float | Integer red, Float | Integer green, Float | Integer blue, Float | Integer alpha) -> nil

      def self.capture_screenshot: (^(ImageData) -> void callable) -> nil

      def self.capture_screenshot_to_file: (String filename) -> nil

      def self.stats: () -> Hash[String, Integer]

      def self.supported: () -> Hash[String, bool]

      def self.system_limits: () -> Hash[String, Float]

      def self.texture_formats: (bool rt, bool computewrite, bool shaderatomics, bool? readable) -> Hash[String, bool]

      def self.texture_types: () -> Hash[String, bool]

      def self.new_default_font: (Integer? size, String? hinting, (Float | Integer)? dpiscale, bool sdf) -> Font

      def self.new_truetype_font: (Data data, Integer size, String? hinting, (Float | Integer)? dpiscale, bool sdf) -> Font

      def self.new_font_from_file: (FileData data) -> Font

      def self.print: (Array[[String, Float | Integer, Float | Integer, Float | Integer, Float | Integer]] text, Font? font, Array[Float | Integer] placement) -> nil

      def self.printf: (Array[[String, Float | Integer, Float | Integer, Float | Integer, Float | Integer]] text, Font? font, Array[Float | Integer] placement, Float | Integer limit, String? align) -> nil

      def self.draw: (Texture texture, Array[Float | Integer] placement) -> nil

      def self.draw_sprite_batch: (SpriteBatch batch, Array[Float | Integer] placement) -> nil

      def self.draw_quad: (Texture texture, Quad quad, Array[Float | Integer] placement) -> nil

      def self.new_quad: (Float | Integer layer, Array[Float | Integer] viewport, Float | Integer sw, Float | Integer sh) -> Quad

      def self.new_quad_of_texture: (Float | Integer layer, Array[Float | Integer] viewport, Texture texture) -> Quad

      def self.new_sprite_batch: (Texture texture, Integer? size, String? usage) -> SpriteBatch

      def self.line: (Array[Float | Integer | Array[Float | Integer]] coordinates) -> nil

      def self.arc: (String drawstr, String? arcstr, Array[Symbol | String | Float | Integer | nil] arguments) -> nil

      def self.points: (Array[Float | Integer] coordinates) -> nil

      def self.polygon: (String mode, Array[Float | Integer] coordinates) -> nil

      def self.set_background_color: (Float | Integer red, Float | Integer green, Float | Integer blue, Float | Integer alpha) -> nil

      def self.set_scissor: (Float | Integer x, Float | Integer y, Float | Integer width, Float | Integer height) -> nil

      def self.reset_scissor: () -> nil

      def self.intersect_scissor: (Float | Integer x, Float | Integer y, Float | Integer width, Float | Integer height) -> nil

      def self.canvas: () -> Texture?

      class Font
        def self.cpp_class: () -> String

        def object_type: () -> String

        def type_of?: (String name) -> bool

        def text_width: (String text) -> Float

        def glyph_width: (Integer | Float glyph) -> Float

        def wrap: (Array[[String, Float | Integer, Float | Integer, Float | Integer, Float | Integer]] text, Float | Integer wraplimit) -> [Float, Array[String]]

        def text_glyphs?: (String text) -> bool

        def glyph?: (Integer | Float glyph) -> bool

        def text_kerning: (String left, String right) -> Float

        def glyph_kerning: (Integer | Float left, Integer | Float right) -> Float

        def set_fallbacks: (Array[Font] fallbacks) -> nil
      end
    end

    class World
      def self.cpp_class: () -> String

      def object_type: () -> String

      def type_of?: (String name) -> bool

      def update: (Float | Integer dt, ?Integer? velocityiterations, ?Integer? positioniterations) -> nil

      def set_callbacks: (Array[::Lota::Physics::World::contact_function?] functions) -> nil

      def callbacks: () -> Array[::Lota::Physics::World::callback]

      def set_contact_filter: (::Lota::Physics::World::contact_filter_function? filter) -> nil

      def contact_filter: () -> ::Lota::Physics::World::callback

      def bodies: () -> Array[Body]

      def joints: () -> Array[Joint]

      def contacts: () -> Array[Contact]

      def gravity: () -> Array[Float]

      def shapes_in_area: (Float | Integer lx, Float | Integer ly, Float | Integer ux, Float | Integer uy, ?Integer? mask) -> Array[Shape]

      def query_shapes_in_area: [T] (Float | Integer lx, Float | Integer ly, Float | Integer ux, Float | Integer uy, Array[(^(Shape, *T) -> ::Object?) | T | nil] call) -> nil

      def ray_cast: [T] (Float | Integer x1, Float | Integer y1, Float | Integer x2, Float | Integer y2, Array[(^(Shape, *(Float | T)) -> (Float | Integer)) | T | nil] call) -> nil

      def ray_cast_any: (Float | Integer x1, Float | Integer y1, Float | Integer x2, Float | Integer y2, ?Integer? mask) -> Array[Shape | Float]

      def ray_cast_closest: (Float | Integer x1, Float | Integer y1, Float | Integer x2, Float | Integer y2, ?Integer? mask) -> Array[Shape | Float]
    end

    class Body
      def self.cpp_class: () -> String

      def object_type: () -> String

      def type_of?: (String name) -> bool

      def shapes: () -> Array[Shape]

      def joints: () -> Array[Joint]

      def contacts: () -> Array[Contact]

      def mass_data: () -> Array[Float]

      def world_points: (Array[Float | Integer] coordinates) -> Array[Float | Integer]

      def local_points: (Array[Float | Integer] coordinates) -> Array[Float | Integer]

      def set_user_data: (::Object? value) -> nil

      def user_data: () -> ::Object?

      def apply_force: (Float | Integer fx, Float | Integer fy, Array[Float | Integer | bool | nil] rest) -> nil

      def apply_linear_impulse: (Float | Integer jx, Float | Integer jy, Array[Float | Integer | bool | nil] rest) -> nil
    end

