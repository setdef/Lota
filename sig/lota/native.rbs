module Lota
  module Native
    VERSION: String

    VERSION_COMPATIBILITY: Array[String]

    def self.drain_release_queue: () -> Integer

    def self.queued_releases: () -> Integer

    class RandomGenerator
      def self.cpp_class: () -> String

      def initialize: () -> void

      def random: () -> Float

      def set_seed: (Float | Integer low, ?(Float | Integer)? high) -> nil

      def type: () -> String

      def type_of?: (String name) -> bool
    end

    module Math
      def self.open: () -> nil

      def self.open?: () -> bool

      def self.random_generator: () -> RandomGenerator
    end

    class Data
      def self.cpp_class: () -> String

      def type: () -> String

      def type_of?: (String name) -> bool

      def string: (?(Float | Integer) offset, ?(Float | Integer)? size) -> String
    end

    class FileData < Data
      def self.cpp_class: () -> String

      def type: () -> String

      def type_of?: (String name) -> bool
    end

    class ImageData
      def self.cpp_class: () -> String

      def type: () -> String

      def type_of?: (String name) -> bool
    end

    class Texture
      def self.cpp_class: () -> String

      def type: () -> String

      def type_of?: (String name) -> bool

      def width: (?Integer? mipmap) -> Integer

      def height: (?Integer? mipmap) -> Integer

      def render_to: (Integer? slice, ^() -> void block) -> nil
    end

    class Quad
      def self.cpp_class: () -> String

      def type: () -> String

      def type_of?: (String name) -> bool

      def layer: () -> Integer

      def set_viewport: (Array[Float | Integer] viewport, ?(Float | Integer)? sw, ?(Float | Integer)? sh) -> nil
    end

    class SpriteBatch
      def self.cpp_class: () -> String

      def type: () -> String

      def type_of?: (String name) -> bool

      def add: (Quad? quad, Array[Float | Integer] placement) -> Integer

      def set: (Integer index, Quad? quad, Array[Float | Integer] placement) -> nil

      def set_color: (Float | Integer red, Float | Integer green, Float | Integer blue, Float | Integer alpha) -> nil

      def texture: () -> Texture
    end

    class WindowSettings
      def self.cpp_class: () -> String

      def initialize: () -> void

      attr_accessor fullscreen: bool

      def set_fullscreentype: (String name) -> bool

      def fullscreentype: () -> String

      attr_reader refreshrate: Float

      attr_accessor vsync: Integer

      attr_accessor msaa: Integer

      attr_accessor stencil: bool

      attr_accessor depth: bool

      attr_accessor resizable: bool

      attr_accessor minwidth: Integer

      attr_accessor minheight: Integer

      attr_accessor borderless: bool

      attr_accessor centered: bool

      attr_accessor displayindex: Integer

      attr_accessor usedpiscale: bool

      attr_accessor useposition: bool

      attr_accessor x: Integer

      attr_accessor y: Integer
    end

    module Filesystem
      def self.open: () -> nil

      def self.open?: () -> bool

      def self.new_file_data: (String contents, String filename) -> FileData

      def self.file_data: (String filename) -> FileData

      def self.info: (String filepath, ?String? filtertype) -> [String, bool, Integer?, Integer?]?

      def self.read: (String filename, ?Integer size) -> ([String, Integer] | [nil, String])

      def self.write_string: (String filename, String contents, ?Integer? size) -> ([true] | [nil, String])

      def self.write_data: (String filename, Data data, ?Integer? size) -> ([true] | [nil, String])

      class Lines
        def self.cpp_class: () -> String

        def initialize: (String filename) -> void

        def next_line: () -> String?
      end
    end

    class Source
      def self.cpp_class: () -> String

      def type: () -> String

      def type_of?: (String name) -> bool
    end

    class Decoder
      def self.cpp_class: () -> String

      def type: () -> String

      def type_of?: (String name) -> bool

      def decode: () -> SoundData?
    end

    class SoundData < Data
      def self.cpp_class: () -> String

      def type: () -> String

      def type_of?: (String name) -> bool

      def slice: (Integer start, ?Integer length) -> SoundData

      def sample: (Float | Integer i, ?(Float | Integer)? channel) -> Float

      def set_sample: (Array[Float | Integer] arguments) -> nil
    end

    module Sound
      def self.open: () -> nil

      def self.open?: () -> bool

      def self.new_decoder: (String filename, Integer buffer_size, ?String? type) -> Decoder

      def self.new_decoder_from_data: (Data data, Integer buffer_size) -> Decoder

      def self.new_sound_data: (Integer samples, Integer sample_rate, Integer bit_depth, Integer channels) -> SoundData

      def self.new_sound_data_from_decoder: (Decoder decoder) -> SoundData
    end

    module Audio
      def self.open: () -> Array[String]

      def self.open?: () -> bool

      def self.new_source: (String filename, String source_type) -> Source

      def self.play: (Source source) -> bool

      def self.stop: () -> nil

      def self.stop_source: (Source source) -> nil
    end

    module Image
      def self.open: () -> nil

      def self.open?: () -> bool

      def self.new_image_data: (Data data) -> ImageData
    end

    module Font
      def self.open: () -> nil

      def self.open?: () -> bool
    end

    module Timer
      def self.open: () -> nil

      def self.open?: () -> bool
    end

    module Event
      def self.open: () -> nil

      def self.open?: () -> bool

      def self.poll: () -> Array[String | Float | Integer | bool | nil]?

      def self.quit: (?Float? exit_status) -> bool

      def self.push: (String name, Array[bool | Float | String] arguments) -> bool
    end

    module Keyboard
      def self.open: () -> nil

      def self.open?: () -> bool

      def self.down?: (Array[String] names) -> bool
    end

    module Mouse
      def self.open: () -> nil

      def self.open?: () -> bool

      def self.system_cursor: (String name) -> Cursor

      def self.down?: (Array[Integer] buttons) -> bool

      class Cursor
        def self.cpp_class: () -> String

        def type: () -> String

        def type_of?: (String name) -> bool
      end
    end

    module System
      def self.open: () -> nil

      def self.open?: () -> bool
    end

    module Touch
      def self.set_trackpad_touch: (bool enable) -> nil
    end

    module Window
      def self.open: () -> nil

      def self.open?: () -> bool

      def self.set_mode: (Integer width, Integer height, WindowSettings? settings) -> bool

      def self.get_window: (WindowSettings settings) -> [Integer, Integer]

      def self.desktop_dimensions: (?Integer? displayindex) -> [Integer, Integer]

      def self.fullscreen_types: () -> Array[String]

      def self.set_high_dpi_allowed: (bool enable) -> nil

      def self.show_message_box: (String title, String message, ?String? type, ?bool attachtowindow) -> bool

      def self.show_message_box_with_buttons: (String title, String message, Array[String] buttons, ?Integer? enterbutton, ?Integer? escapebutton, ?String? type, ?bool attachtowindow) -> Integer
    end

    module Graphics
      def self.open: () -> nil

      def self.open?: () -> bool

      def self.set_gamma_correct: (bool gamma_correct) -> nil

      def self.set_low_power_preferred: (bool preferred) -> nil

      def self.default_renderers: () -> Array[String]

      def self.set_renderers: (Array[String] names) -> nil

      def self.push: (?String? stack) -> nil

      def self.present: () -> nil

      def self.new_canvas: (Integer? width, Integer? height, Integer? msaa) -> Texture

      def self.new_texture_from_data: (Data data, bool canvas) -> Texture

      def self.new_texture_from_image_data: (ImageData data, bool canvas) -> Texture

      def self.set_canvas: (Texture texture) -> nil

      def self.reset_canvas: () -> nil

      def self.clear: (Float | Integer red, Float | Integer green, Float | Integer blue, Float | Integer alpha) -> nil

      def self.readback_texture: (Texture texture) -> ImageData

      def self.set_color: (Float | Integer red, Float | Integer green, Float | Integer blue, Float | Integer alpha) -> nil

      def self.capture_screenshot: (^(ImageData) -> void callable) -> nil

      def self.new_default_font: (Integer? size, String? hinting, (Float | Integer)? dpiscale, bool sdf) -> Font

      def self.new_truetype_font: (Data data, Integer size, String? hinting, (Float | Integer)? dpiscale, bool sdf) -> Font

      def self.new_font_from_file: (FileData data) -> Font

      def self.font: () -> Font

      def self.print: (Array[[String, Float | Integer, Float | Integer, Float | Integer, Float | Integer]] text, Font? font, Array[Float | Integer] placement) -> nil

      def self.printf: (Array[[String, Float | Integer, Float | Integer, Float | Integer, Float | Integer]] text, Font? font, Array[Float | Integer] placement, Float | Integer limit, String? align) -> nil

      def self.default_filter: () -> [String, String, Integer]

      def self.draw: (Texture texture, Array[Float | Integer] placement) -> nil

      def self.draw_sprite_batch: (SpriteBatch batch, Array[Float | Integer] placement) -> nil

      def self.draw_quad: (Texture texture, Quad quad, Array[Float | Integer] placement) -> nil

      def self.new_quad: (Float | Integer layer, Array[Float | Integer] viewport, Float | Integer sw, Float | Integer sh) -> Quad

      def self.new_quad_of_texture: (Float | Integer layer, Array[Float | Integer] viewport, Texture texture) -> Quad

      def self.new_sprite_batch: (Texture texture, Integer? size, String? usage) -> SpriteBatch

      def self.line: (Array[Float | Integer | Array[Float | Integer]] coordinates) -> nil

      def self.arc: (String drawstr, String? arcstr, Array[Symbol | String | Float | Integer | nil] arguments) -> nil

      class Font
        def self.cpp_class: () -> String

        def type: () -> String

        def type_of?: (String name) -> bool
      end
    end
  end
end
