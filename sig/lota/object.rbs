module Lota
  interface _EngineNative
    def object_type: () -> String

    def type_of?: (String name) -> bool
  end

  interface _WrapsObject
    def native: () -> _EngineNative
  end

  module Object : _WrapsObject
    module TypeRule : Module
      def method_added: (Symbol name) -> void
    end

    def self.included: (Module base) -> void

    def object_type: () -> String

    def type: () -> String

    def type_of?: (::Object name) -> bool
  end
end
