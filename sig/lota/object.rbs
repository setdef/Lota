module Lota
  interface _EngineNative
    def type: () -> String

    def type_of?: (String name) -> bool
  end

  interface _WrapsObject
    def native: () -> _EngineNative
  end

  module Object : _WrapsObject
    def type: () -> String

    def type_of?: (::Object name) -> bool
  end
end
