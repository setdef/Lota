module Lota
  interface _EngineNative
    def object_type: () -> String

    def type_of?: (String name) -> bool

    def to_s: () -> String

    def ==: (::Object other) -> bool

    def release: () -> bool
  end

  class Object[out N < _EngineNative = _EngineNative]
    private def self.method_added: (Symbol name) -> void

    attr_reader native: N

    def object_type: () -> String

    def type: () -> String

    def type_of?: (::Object name) -> bool

    def release: () -> bool

    def to_s: () -> String

    def ==: (::Object other) -> bool
  end
end
