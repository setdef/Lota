module Lota
  class Boot
    MODULES: Hash[Symbol, (^() -> void)?]

    @path: String?

    @arguments: Array[String]

    @fused: bool

    interface _Frame
      def call: () -> ::Object?

      def equal?: (top other) -> bool
    end

    @inerror: bool

    @func: _Frame?

    @set_modal_draw_func: bool

    private def set_default_modal_draw_callback: (_Frame? frame) -> void

    attr_reader directory: String

    attr_reader settings: Settings

    attr_reader restart_value: Restart::value

    @restart: bool

    def restart?: () -> bool

    private def finish: (::Object? retval) -> Integer

    private def phone?: () -> bool

    def initialize: (String? path, ?Array[String] arguments, ?fused: bool) -> void

    def call: () -> Integer

    def init: () -> void

    private def boot: () -> void

    private def init_game: () -> void

    private def earlyinit: () -> Integer?

    private def protect: [T] () { () -> T } -> ([true, T] | [false, nil])

    private def handle_error: (Exception error) -> void

    def configure: () -> (StandardError | ScriptError)?

    def read_settings: () -> Settings

    private def open_filesystem: () -> void

    private def identity: () -> String

    def self.folder_identity: (String directory) -> String

    private def add_to_load_path: () -> void

    private def prepare_engine: () -> void

    private def prepare_audio: () -> void

    private def renderers: (Settings::Graphics? graphics) -> Array[Symbol]

    private def open_modules: () -> void

    private def check_version: () -> void

    private def tostring: (::Object? value) -> String

    private def open_window: () -> void

    private def no_game_code?: () -> bool

    private def conf_file: () -> String

    private def main_file: () -> String

    private def capture: () { () -> top } -> (StandardError | ScriptError)?
  end
end
