module Lota
  module CLI
    def self.call: (Array[String] argv) -> Integer

    def self.usage: () -> String

    module Commands
      module Fuse
        PHONES: Array[String]

        VALUES: Hash[String, Symbol]

        REPEATED: Hash[String, Symbol]

        def self.call: (Array[String] argv) -> void

        def self.parse: (Array[String] argv) -> [String, Hash[Symbol, String | Array[String]]]

        def self.usage: () -> String
      end
    end
  end
end
