module Lota
  module NoGame
    TITLE: String

    TEXT: String

    TEXT_SIZE: Integer

    BACKGROUND: Array[Float]

    FOREGROUND: Array[Float]

    CALLBACKS: Array[Symbol]

    self.@font: Graphics::Font?

    def self.call: () -> nil

    def self.load: () -> void

    def self.draw: () -> void

    def self.mousepressed: (Float _x, Float _y, Integer _b, bool istouch, Integer clicks) -> void

    def self.keypressed: (Symbol key) -> void

    def self.conf: (Settings t) -> void

    def self.restart_with_new_game: (String path) -> void

    def self.filedropped: (Filesystem::File file) -> void

    def self.directorydropped: (String path) -> void
  end
end
