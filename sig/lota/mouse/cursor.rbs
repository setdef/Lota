module Lota
  module Mouse
    class Cursor < Object[Native::Mouse::Cursor]
      private def self.from_native: (Native::Mouse::Cursor native) -> Cursor

      def self.new: (Image::ImageData | Filesystem::FileData | String | Array[Image::ImageData | Filesystem::FileData | String] image, ?Integer hotx, ?Integer hoty) -> Cursor

      def get_type: () -> Symbol
    end
  end
end
