module Lota
  module Filesystem
    class Info < ::Data
      include Record

      attr_reader type: Symbol

      attr_reader readonly: bool

      attr_reader size: Integer?

      attr_reader modtime: Integer?

      def self.new: (type: Symbol, readonly: bool, size: Integer?, modtime: Integer?) -> instance
    end
  end
end
