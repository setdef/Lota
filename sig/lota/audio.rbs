module Lota
  module Audio
    def self.play: (Source | Array[Source] source, *Source more) -> bool

    private def self.natives_of: (Array[Source] sources) -> Array[Native::Source]

    private def self.native_of: (Source source) -> Native::Source

    def self.stop: (?(Source | Array[Source])? source, *Source more) -> nil

    def self.volume: () -> Float

    def self.volume=: (Float | Integer volume) -> void

    def self.active_source_count: () -> Integer

    type numbers = Float | Integer | Array[Float | Integer]

    def self.position=: (numbers position) -> void

    def self.position: () -> [Float, Float, Float]

    def self.orientation=: (numbers orientation) -> void

    def self.orientation: () -> [Float, Float, Float, Float, Float, Float]

    def self.velocity=: (numbers velocity) -> void

    def self.velocity: () -> [Float, Float, Float]

    def self.doppler_scale=: (Float | Integer scale) -> void

    def self.doppler_scale: () -> Float

    def self.distance_model=: (Symbol | String model) -> void

    def self.distance_model: () -> Symbol

    def self.pause: (?nil source) -> Array[Source]
                  | (Source | Array[Source] source, *Source more) -> nil

    def self.set_effect: (String name, ?bool? enabled, **Source::setting settings) -> bool

    def self.effect: (String name) -> Effect?

    def self.active_effects: () -> Array[String]

    def self.max_scene_effects: () -> Integer

    def self.max_source_effects: () -> Integer

    def self.effects_supported?: () -> bool

    def self.set_mix_with_system: (bool mix) -> bool

    def self.playback_device: () -> String

    def self.playback_devices: () -> Array[String]

    def self.set_playback_device: (?String? name) -> Array[bool | String]

    def self.recording_devices: () -> Array[RecordingDevice]

    def self.set_output_spatialization: (bool enable, ?String? filter) -> bool

    def self.output_spatialization: () -> Array[bool | String | nil]

    def self.output_spatialization_filters: () -> Array[String]

    private def self.setting_pairs: (Hash[Symbol, Source::setting] settings) -> Array[[String, Float | Integer | bool | String]]?
  end
end
