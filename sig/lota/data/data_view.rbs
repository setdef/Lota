module Lota
  class Data[out N < Native::Data::Data = Native::Data::Data]
    class DataView < Data[Native::DataView]
      private def self.from_native: (Native::DataView native) -> DataView

      def self.new: (Data data, Integer offset, ?Integer? size) -> DataView

      def initialize_copy: (DataView source) -> void
    end
  end
end
