module Lota
  class Data[out N < Native::Data::Data = Native::Data::Data]
    class CompressedData < Data[Native::CompressedData]
      private def self.from_native: (Native::CompressedData native) -> CompressedData

      def initialize_copy: (CompressedData source) -> void

      def format: () -> Symbol
    end
  end
end
