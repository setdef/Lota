module Lota
  module Data
    class CompressedData
      include Object
      include Data

      attr_reader native: Native::CompressedData

      def self.from_native: (Native::CompressedData native) -> CompressedData

      def initialize_copy: (CompressedData source) -> void

      def format: () -> Symbol
    end
  end
end
