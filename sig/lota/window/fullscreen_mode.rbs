module Lota
  module Window
    class FullscreenMode < ::Data
      include Record

      attr_reader width: Integer

      attr_reader height: Integer

      attr_reader refreshrate: Float

      def self.new: (width: Integer, height: Integer, refreshrate: Float) -> instance
    end
  end
end
