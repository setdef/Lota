module Lota
  module Callbacks
    type argument = String | Symbol | Float | Integer | bool | nil

    type handler = ^(*argument) -> Object?

    self.@parsed_game_arguments: Array[String]

    self.@raw_game_arguments: Array[String]

    attr_accessor self.parsed_game_arguments: Array[String]

    attr_accessor self.raw_game_arguments: Array[String]

    def self.call: (Symbol name, *top arguments) -> Object?

    ENUM_ARGUMENTS: Hash[Symbol, Array[Integer]]

    def self.poll: () -> [Symbol, Array[argument]]?

    HANDLERS: Hash[Symbol, handler]

    def self.dispatch: () -> argument

    def self.handle: (Symbol name, *argument arguments) -> Object?
  end

  module DefaultCallbacks
    def run: () -> ^() -> Object?
  end
end
