module Lota
  module Font
    class GlyphData < Data[Native::GlyphData]
      private def self.from_native: (Native::GlyphData native) -> GlyphData

      def self.new: (Rasterizer rasterizer, String | Integer | Float glyph) -> GlyphData

      def initialize: (Rasterizer rasterizer, String | Integer | Float glyph) -> void

      def initialize_copy: (GlyphData source) -> void

      def width: () -> Integer

      def height: () -> Integer

      def dimensions: () -> [Integer, Integer]

      def glyph: () -> Integer

      def glyph_string: () -> String

      def advance: () -> Integer

      def bearing: () -> [Integer, Integer]

      def bounding_box: () -> [Integer, Integer, Integer, Integer]

      def format: () -> Symbol
    end
  end
end
