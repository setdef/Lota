module Lota
  module Font
    class Rasterizer < Object[Native::Rasterizer]
      private def self.from_native: (Native::Rasterizer native) -> Rasterizer

      def self.new: (*::Object? arguments, ?hinting: (Symbol | String)?, ?dpiscale: (Float | Integer)?, ?sdf: bool) -> Rasterizer

      def initialize: (*::Object? arguments, ?hinting: (Symbol | String)?, ?dpiscale: (Float | Integer)?, ?sdf: bool) -> void

      def height: () -> Integer

      def advance: () -> Integer

      def ascent: () -> Integer

      def descent: () -> Integer

      def line_height: () -> Integer

      def glyph_data: (String | Integer | Float glyph) -> GlyphData

      def glyph_count: () -> Integer

      def glyphs?: (*(String | Integer | Float) glyphs) -> bool
    end
  end
end
