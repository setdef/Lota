module Lota
  module Font
    module TrueTypeRasterizer
      def self.new: (*::Object? arguments, ?hinting: (Symbol | String)?, ?dpiscale: (Float | Integer)?, ?sdf: bool) -> Rasterizer

      private def self.native: (Array[::Object?] arguments, ::Object? hinting, ::Object? dpiscale, bool sdf) -> Native::Rasterizer

      private def self.settings: (Array[::Object?] legacy, ::Object? hinting, ::Object? dpiscale, bool sdf) -> [String?, (Float | Integer)?]

      private def self.name_of: (::Object? hinting) -> String?

      def self.===: (::Object? object) -> bool
    end
  end
end
