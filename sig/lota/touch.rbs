module Lota
  module Touch
    def self.touches: (?(Symbol | String)? filter) -> Array[Integer]

    def self.position: (Integer id) -> [Float, Float]

    def self.pressure: (Integer id) -> Float

    def self.device_type: (Integer id) -> Symbol

    def self.mouse?: (Integer id) -> bool

    private def self.touch_id: (::Object id) -> Integer
  end
end
