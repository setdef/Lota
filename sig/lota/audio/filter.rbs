module Lota
  module Audio
    class Filter < ::Data
      include Record

      attr_reader type: Symbol?

      attr_reader volume: Float?

      attr_reader lowgain: Float?

      attr_reader highgain: Float?

      def self.new: (type: Symbol?, volume: Float?, lowgain: Float?, highgain: Float?) -> instance
                  | (*(Symbol | Float)? values) -> instance

      private def self.of: (Array[[String, Float | String]] pairs) -> Filter
    end
  end
end
