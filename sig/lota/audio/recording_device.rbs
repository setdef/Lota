module Lota
  module Audio
    class RecordingDevice < Object[Native::RecordingDevice]
      private def self.from_native: (Native::RecordingDevice native) -> RecordingDevice

      def start: (?Integer? samples, ?Integer? samplerate, ?Integer? bitdepth, ?Integer? channels) -> bool

      def stop: () -> Sound::SoundData?

      def data: () -> Sound::SoundData?

      def sample_count: () -> Integer

      def sample_rate: () -> Integer

      def bit_depth: () -> Integer

      def channel_count: () -> Integer

      def name: () -> String

      def recording?: () -> bool

      private def sound: (Native::SoundData? native) -> Sound::SoundData?
    end
  end
end
