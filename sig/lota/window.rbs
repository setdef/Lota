module Lota
  module Window
    def self.set_mode: (Integer width, Integer height, ?fullscreen: bool?, ?fullscreentype: (Symbol | String)?, ?vsync: (Integer | bool)?, ?msaa: Integer?, ?stencil: bool?, ?depth: (bool | Integer | Float)?, ?resizable: bool?, ?minwidth: Integer?, ?minheight: Integer?, ?borderless: bool?, ?centered: bool?, ?displayindex: Integer?, ?display: (Integer | Float)?, ?highdpi: bool?, ?usedpiscale: bool?, ?refreshrate: (Integer | Float)?, ?x: Integer?, ?y: Integer?) -> bool

    def self.update_mode: (?(Integer | Float)? width, ?(Integer | Float)? height, ?fullscreen: bool?, ?fullscreentype: (Symbol | String)?, ?vsync: (Integer | bool)?, ?msaa: Integer?, ?stencil: bool?, ?depth: (bool | Integer | Float)?, ?resizable: bool?, ?minwidth: Integer?, ?minheight: Integer?, ?borderless: bool?, ?centered: bool?, ?displayindex: Integer?, ?display: (Integer | Float)?, ?highdpi: bool?, ?usedpiscale: bool?, ?refreshrate: (Integer | Float)?, ?x: Integer?, ?y: Integer?) -> bool

    def self.mode: () -> [Integer, Integer, Mode]

    def self.desktop_dimensions: (?Integer? displayindex) -> [Integer, Integer]

    def self.safe_area: () -> Array[Integer]

    private def self.read_window_settings: (Native::WindowSettings settings, fullscreen: bool?, fullscreentype: (Symbol | String)?, vsync: (Integer | bool)?, msaa: Integer?, stencil: bool?, depth: (bool | Integer | Float)?, resizable: bool?, minwidth: Integer?, minheight: Integer?, borderless: bool?, centered: bool?, displayindex: Integer?, display: (Integer | Float)?, highdpi: bool?, usedpiscale: bool?, x: Integer?, y: Integer?, where: String) -> Native::WindowSettings

    private def self.depth_of: (::Object? value, bool default, String where) -> bool

    private def self.deprecated_display: (::Object value, String where) -> Integer

    private def self.deprecated_highdpi: (::Object value, String where) -> void

    private def self.where: (Array[Thread::Backtrace::Location]? locations) -> String

    private def self.flag: (::Object? value, bool default) -> bool

    private def self.integer: (::Object? value, Integer default) -> Integer

    private def self.vsync_of: (::Object? value, Integer default) -> Integer

    def self.display_count: () -> Integer

    def self.display_name: (Integer index) -> String

    def self.display_orientation: (?Integer? displayindex) -> Symbol

    def self.fullscreen_modes: (?Integer? displayindex) -> Array[FullscreenMode]

    def self.fullscreen: () -> [bool, Symbol]

    def self.set_fullscreen: (bool fullscreen, ?(Symbol | String)? fullscreentype) -> bool

    def self.close: () -> nil

    def self.position: () -> [Integer, Integer, Integer]

    def self.position=: ([Integer, Integer] | [Integer, Integer, Integer?] | [Integer, Integer, Integer?, bool?] position) -> void

    def self.icon: () -> Lota::Image::ImageData?

    def self.set_icon: (Lota::Image::ImageData imagedata) -> bool

    def self.vsync: () -> Integer

    def self.vsync=: (Integer | Float | bool vsync) -> void

    def self.display_sleep_enabled?: () -> bool

    def self.display_sleep_enabled=: (bool enable) -> void

    def self.focus?: () -> bool

    def self.mouse_focus?: () -> bool

    def self.visible?: () -> bool

    def self.occluded?: () -> bool

    def self.maximized?: () -> bool

    def self.minimized?: () -> bool

    def self.maximize: () -> nil

    def self.minimize: () -> nil

    def self.restore: () -> nil

    def self.focus: () -> nil

    def self.request_attention: (?bool continuous) -> nil

    def self.dpi_scale: () -> Float

    def self.native_dpi_scale: () -> Float

    def self.to_pixels: (Float | Integer wx, ?(Float | Integer)? wy) -> (Float | Array[Float])

    def self.from_pixels: (Float | Integer px, ?(Float | Integer)? py) -> (Float | Array[Float])

    def self.system_theme: () -> Symbol

    def self.pointer: () -> Fiddle::Pointer

    def self.show_message_box: (String title, String message, ?(Array[String] | Symbol | String)? buttons_or_type, *(Symbol | String | bool)? options, ?enterbutton: Integer?, ?escapebutton: Integer?) -> (bool | Integer)

    interface _FileDialogCallable
      def call: (*(Array[String] | String | nil)) -> void
    end

    type file_dialog_callable = ::Object & _FileDialogCallable

    def self.show_file_dialog: (Symbol | String type, ?file_dialog_callable? callable, ?title: String?, ?acceptlabel: String?, ?cancellabel: String?, ?defaultname: String?, ?filters: Hash[String, String]?, ?multiselect: bool?, ?attachtowindow: bool?) ?{ (Array[String] files, String? filter, String? error) -> void } -> nil

    private def self.file_dialog_callable: (file_dialog_callable? callable, Proc? block) -> file_dialog_callable

    private def self.dialog_string: (::Object? value, Symbol name) -> String

    private def self.dialog_flag: (::Object? value, Symbol name) -> bool

    private def self.dialog_filters: (::Object? filters) -> Array[[String, String]]

    def self.title=: (String title) -> void

    def self.title: () -> String

    def self.high_dpi_allowed?: () -> bool

    def self.open?: () -> bool
  end
end
