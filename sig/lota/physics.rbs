module Lota
  module Physics
    def self.meter: () -> Integer

    def self.meter=: (Float | Integer scale) -> void

    def self.distance: (Shape shape1, Shape shape2) -> Array[Float]

    def self.compute_linear_stiffness: (Float | Integer frequency, Float | Integer damping_ratio, Body body1, ?Body? body2) -> [Float, Float]

    def self.compute_linear_frequency: (Float | Integer stiffness, Float | Integer damping, Body body1, ?Body? body2) -> [Float, Float]

    def self.compute_angular_stiffness: (Float | Integer frequency, Float | Integer damping_ratio, Body body1, ?Body? body2) -> [Float, Float]

    def self.compute_angular_frequency: (Float | Integer stiffness, Float | Integer damping, Body body1, ?Body? body2) -> [Float, Float]

    def self.new_circle_body: (World world, Symbol | String type, Float | Integer x, Float | Integer y, Float | Integer radius) -> [Body, CircleShape]

    def self.new_rectangle_body: (World world, Symbol | String type, Float | Integer x, Float | Integer y, Float | Integer width, Float | Integer height, ?(Float | Integer) angle) -> [Body, PolygonShape]

    def self.new_polygon_body: (World world, Symbol | String type, *(Float | Integer | Array[Float | Integer]) coordinates) -> [Body, PolygonShape]

    def self.new_edge_body: (World world, Symbol | String type, Float | Integer x1, Float | Integer y1, Float | Integer x2, Float | Integer y2, ?(Float | Integer)? prevx, ?(Float | Integer)? prevy, ?(Float | Integer)? nextx, ?(Float | Integer)? nexty) -> [Body, EdgeShape]

    def self.new_chain_body: (World world, Symbol | String type, bool loop, *(Float | Integer | Array[Float | Integer]) coordinates) -> [Body, ChainShape]

    private def self.shape: (Native::Shape? native) -> Shape?

    private def self.joint: (Native::Joint native) -> Joint?
  end
end
