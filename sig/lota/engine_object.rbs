module Lota
  interface _EngineNative
    def type: () -> String

    def type_of?: (String name) -> bool
  end

  interface _WrapsEngineObject
    def native: () -> _EngineNative
  end

  module EngineObject : _WrapsEngineObject
    def type: () -> String

    def type_of?: (Object name) -> bool
  end
end
