module Lota
  class Fuse
    class Error < StandardError
    end

    class Options < ::Data
      attr_reader out: String

      attr_reader sign: String?

      attr_reader sign_command: String?

      attr_reader notarize: String?

      attr_reader identifier: String?

      attr_reader app_version: String?

      attr_reader icon: String?

      attr_reader exclude: Array[String]

      def self.new: (out: String, sign: String?, sign_command: String?, notarize: String?, identifier: String?, app_version: String?, icon: String?, exclude: Array[String]) -> instance
    end

    NO_PATTERNS: Array[String]

    DEFAULT_OPTIONS: { out: String, sign: String?, sign_command: String?, notarize: String?, identifier: String?, app_version: String?, icon: String?, exclude: Array[String] }

    def self.options: (?out: String, ?sign: String?, ?sign_command: String?, ?notarize: String?, ?identifier: String?, ?app_version: String?, ?icon: String?, ?exclude: Array[String]) -> Options

    FLEDGE_GIT: String

    FLEDGE_REF: String

    FLEDGE_REF_VARIABLE: String

    IDENTIFIER_PREFIX: String

    PLATFORMS: Array[String]

    GAME_FOLDER: String

    PROJECT_FOLDER: String

    TOOLS_FOLDER: String

    UNTITLED: String

    UNSAFE: Regexp

    RESERVED: Regexp

    LEFT_OUT: Array[String]

    REQUIRED: Array[String]

    EXCLUDE_FLAGS: Integer

    NAMED_LEFT_OUT: Integer

    @directory: String

    @options: Options

    @platform: String

    @gem_file: String?

    @bundle: Array[String]?

    @left_out: Array[String]

    @matched: Array[String]

    def initialize: (String path, ?Options options, ?platform: String, ?gem_file: String?, ?bundle: Array[String]?) -> void

    def call: () -> Array[String]

    LOCKING: String

    COMPILER: String

    def out: () -> String

    def project: () -> String

    def tools: () -> String

    def self.this_platform: () -> String

    def self.installed_gem: (String platform) -> String

    def self.folder_name: (String identity) -> String

    def self.placeholder_identifier: (String identity) -> String

    def self.platform_name: (String platform) -> String?

    def self.fledge_ref: (?Hash[String, String] env) -> String

    private def check_game: () -> void

    private def check_exclude: () -> void

    private def check_signing: () -> void

    private def excludes?: (String pattern, String relative, directory: bool) -> bool

    private def report_left_out: () -> void

    private def excluded?: (String source) -> bool

    private def read_settings: () -> Settings

    private def lota_platform: () -> String

    private def read_lockfile: (String platform) -> Lockfile?

    private def check_lockfile: (Lockfile locked, String path, String platform) -> void

    private def check_git: () -> void

    private def write_notices: (String gem) -> void

    private def gem_folder: (String name) -> String

    private def bundler: () -> Array[String]

    private def executable: (String name) -> String?

    private def write_project: (Settings settings, String gem, Lockfile? locked) -> void

    private def copy_cache: (String cache, Lockfile locked) -> void

    private def lock_commands: (Lockfile? locked, String platform) -> Array[Array[String]]

    private def identity: (Settings settings) -> String

    private def name: (Settings settings) -> String

    private def copy_game: (String from, String to) -> void

    private def gemfile: (String folder, Lockfile? locked) -> String

    private def write_tools: () -> void

    private def fledge_yml: (String name, String identity, String folder) -> String

    private def entry_script: (String folder) -> String

    private def run: (Array[String] bundle, *String arguments, folder: String, step: String, why: String) -> void

    private def network: () -> String

    private def build: (Array[String] bundle, ?why: String?) -> Array[String]

    private def environment: (String folder) -> Hash[String, String?]
  end
end

module Gem
  class Package
    def self.new: (String gem) -> Package

    def extract_files: (String destination_dir, ?String pattern) -> void
  end
end
