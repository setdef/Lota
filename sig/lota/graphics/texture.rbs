module Lota
  module Graphics
    class Texture
      attr_reader native: Native::Texture

      def self.from_native: (Native::Texture native) -> Texture

      def self.new: (String | Filesystem::FileData | Lota::Image::ImageData image, ?canvas: ::Object?) -> Texture

      def canvas?: () -> bool

      def width: (?Integer? mipmap) -> Integer

      def height: (?Integer? mipmap) -> Integer

      def dimensions: (?Integer? mipmap) -> [Integer, Integer]

      def render_to: (?Integer? slice) { () -> void } -> nil
    end
  end
end
