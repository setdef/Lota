module Lota
  module Graphics
    class Quad < Object[Native::Quad]
      private def self.from_native: (Native::Quad native) -> Quad

      def self.new: (Float | Integer x, Float | Integer y, Float | Integer w, Float | Integer h, Texture | Float | Integer first, ?(Texture | Float | Integer)? second, ?(Float | Integer)? third) -> Quad

      def viewport: () -> Array[Float]

      def viewport=: (Array[Float | Integer] viewport) -> void

      def texture_dimensions: () -> Array[Float]

      def layer: () -> Integer

      def layer=: (Integer layer) -> void
    end
  end
end
