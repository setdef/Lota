module Lota
  module Graphics
    class GraphicsReadback < Object[Native::GraphicsReadback]
      private def self.from_native: (Native::GraphicsReadback native) -> GraphicsReadback

      def complete?: () -> bool

      def error?: () -> bool

      def wait: () -> nil

      def update: () -> nil

      def buffer_data: () -> Lota::Data::ByteData?

      def image_data: () -> Lota::Image::ImageData?
    end
  end
end
