module Lota
  module Sound
    class Decoder
      include Object

      DEFAULT_BUFFER_SIZE: Integer

      attr_reader native: Native::Decoder

      def self.from_native: (Native::Decoder native) -> Decoder

      def self.new: (String | Filesystem::FileData file, ?Integer buffer_size, ?(Symbol | String)? type) -> Decoder

      def decode: () -> SoundData?

      def channel_count: () -> Integer

      def bit_depth: () -> Integer

      def sample_rate: () -> Integer

      def duration: () -> Float
    end
  end
end
