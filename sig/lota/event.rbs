module Lota
  module Event
    def self.pump: (?(Float | Integer) wait_timeout) -> nil

    def self.poll: () { (Symbol name, *Callbacks::argument arguments) -> void } -> nil
                 | () -> Enumerator[Array[Callbacks::argument], nil]

    def self.push: (Symbol | String name, *Variant::carried arguments) -> bool

    def self.wait: () -> Array[Symbol | Callbacks::argument]?

    def self.clear: () -> nil

    def self.quit: (?(Integer | Float)? exit_status) -> bool

    def self.restart: (*Variant::carried arguments) -> bool

    interface _Callable
      def call: () -> ::Object?
    end

    type callable = ::Object & _Callable

    def self.modal_draw_callback=: (callable? callable) -> void
  end
end
