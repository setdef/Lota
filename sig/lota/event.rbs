module Lota
  module Event
    def self.pump: (?(Float | Integer) wait_timeout) -> nil

    def self.poll: () { (Symbol name, *Callbacks::argument arguments) -> void } -> nil
                 | () -> Enumerator[Array[Callbacks::argument], nil]

    def self.push: (Symbol | String name, *(bool | Float | Integer | String | Symbol | nil) arguments) -> bool

    def self.wait: () -> Array[Symbol | Callbacks::argument]?

    def self.clear: () -> nil

    def self.quit: (?(Integer | Float)? exit_status) -> bool

    def self.restart: (*(bool | Float | Integer | String | Symbol | nil) arguments) -> bool

    interface _Callable
      def call: () -> ::Object?
    end

    type callable = ::Object & _Callable

    def self.modal_draw_callback=: (callable? callable) -> void

    private def self.variants: (Array[bool | Float | Integer | String | Symbol | nil] arguments) -> Array[bool | Float | String]
  end
end
