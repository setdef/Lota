module Lota
  extend DefaultCallbacks

  def self.filesystem: () -> singleton(Filesystem)

  def self.image: () -> singleton(Image)?

  def self.font: () -> singleton(Font)?

  def self.graphics: () -> singleton(Graphics)?

  def self.timer: () -> singleton(Timer)?

  def self.event: () -> singleton(Event)?

  def self.keyboard: () -> singleton(Keyboard)?

  def self.mouse: () -> singleton(Mouse)?

  def self.sound: () -> singleton(Sound)?

  def self.audio: () -> singleton(Audio)?

  def self.math: () -> singleton(Math)?

  def self.system: () -> singleton(System)?

  def self.window: () -> singleton(Window)?
end

module Kernel
  private def lota: () -> singleton(Lota)
end
