module Fiddle
  class Pointer
    def initialize: (Integer address, ?Integer size) -> void

    def to_i: () -> Integer

    def size: () -> Integer

    def null?: () -> bool

    def []: (Integer offset) -> Integer
          | (Integer offset, Integer length) -> String

    def to_str: (?Integer length) -> String
  end
end
