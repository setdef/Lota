# Sample Game's own program, which a build names in place of the entry
# script the iOS kit would write: it boots the game folder above it as a
# fused game, with standard output in sync mode, so each line reaches a
# phone's log as it is printed.
$stdout.sync = true
require "lota"
exit Lota::Boot.new(File.expand_path("..", __dir__), ARGV, fused: true).call
