+ *    in a product, an acknowledgment in the product documentation would be
+ *    appreciated but is not required.
+ * 2. Altered source versions must be plainly marked as such, and must not be
+ *    misrepresented as being the original software.
+ * 3. This notice may not be removed or altered from any source distribution.
+ **/
+
+// Added by Lota's physics patch: what LÖVE keeps for a game in a Lua
+// Reference (common/Reference.h), behind an interface the binding that
+// drives the engine implements.
+
+#ifndef LOVE_PHYSICS_BOX2D_REFERENCE_H
+#define LOVE_PHYSICS_BOX2D_REFERENCE_H
+
+namespace love
+{
+namespace physics
+{
+namespace box2d
+{
+
+class Shape;
+class Contact;
+
+/**
+ * A value of the game's that the engine keeps for it: a Body's, Shape's,
+ * or Joint's user data, or a function a World calls back. The engine owns
+ * it and deletes it.
+ **/
+class Reference
+{
+public:
+	virtual ~Reference() {}
+
+	/**
+	 * Lets go of the value while its owner lives on, as a destroyed Body
+	 * lets go of its user data.
+	 **/
+	virtual void unref() = 0;
+};
+
+/**
+ * A function World:setCallbacks takes: called with the contact's two
+ * Shapes, the Contact, and, after the solver, each contact point's normal
+ * and tangent impulse, in that order.
+ **/
+class ContactFunction : public Reference
+{
+public:
+	virtual void call(Shape *a, Shape *b, Contact *contact, const float *impulses, int count) = 0;
+};
+
+/**
+ * The function World:setContactFilter takes: whether two Shapes collide.
+ **/
+class ContactFilterFunction : public Reference
+{
+public:
+	virtual bool call(Shape *a, Shape *b) = 0;
+};
+
+/**
+ * The function World:queryShapesInArea calls for each Shape in the area:
+ * whether to go on.
+ **/
+class QueryFunction
+{
+public:
+	virtual ~QueryFunction() {}
+	virtual bool call(Shape *shape) = 0;
+};
+
+/**
+ * The function World:rayCast calls for each Shape the ray hits, with the
+ * point, the normal, and the fraction of the ray: the fraction to clip the
+ * ray to.
+ **/
+class RayCastFunction
+{
+public:
+	virtual ~RayCastFunction() {}
+	virtual float call(Shape *shape, float x, float y, float xn, float yn, float fraction) = 0;
+};
+
+} // box2d
+} // physics
+} // love
+
+#endif // LOVE_PHYSICS_BOX2D_REFERENCE_H
