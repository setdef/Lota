#
# Runs rake prepush and rake red_before_green on what is being pushed,
# here, or on build machines when LOTA_PREPUSH=machines (tasks/prepush.rb).
# bin/setup points core.hooksPath here. git passes the refs on standard
# input, which the Ruby reads.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
exec bundle exec ruby tasks/prepush.rb "$@"
