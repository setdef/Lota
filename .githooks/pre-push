# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Runs rake push_check over what is being pushed (tasks/prepush.rb), the
# same checks on Linux, macOS, and Windows. bin/setup writes a stub into
# the clone's hooks folder that runs this file. git passes the refs on
# standard input, which the Ruby reads.
#
# It sets up what the checks need where that is missing, so it also runs
# in a checkout bin/setup has never touched, under a HOME where nothing
# is installed: the tools mise.toml pins, under mise x, which installs
# those missing and trusts the checkout's mise.toml by its own rules
# (with CI=true without recording it; never in mise's paranoid mode);
# LÖVE's source, which two unit tests read; and the bundle, in the
# checkout's own vendor/bundle, where bin/setup puts it. On Windows the
# Ruby is the one every Windows job runs, which .github/windows_ruby.env
# pins.
#
# Of mise.toml's tools it asks only for those the checks run: Ruby, with
# the Rust mise compiles it with and, on macOS, the libyaml source its
# psych builds from (bin/with-libyaml), and the REUSE tool, with the
# Python and uv mise installs it with. The rest, which build and lint the
# C++, stay bin/setup's to install, so a first push from a new checkout
# does not wait for a C++ toolchain.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
if [ -z "${LOTA_UNDER_MISE:-}" ] && command -v mise > /dev/null 2>&1; then
  MISE_ENABLE_TOOLS=ruby,rust,http:libyaml,python,uv,pipx:reuse LOTA_UNDER_MISE=1 \
    exec bin/with-libyaml mise x -- sh "$0" "$@"
fi
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*)
    case "$(uname -m)" in
      aarch64 | arm64) arch=arm64 ;;
      *) arch=x64 ;;
    esac
    cache=$(cygpath -u "${XDG_CACHE_HOME:-$HOME/.cache}")/lota/windows-ruby
    ruby_bin=$(bash .github/windows_ruby.sh "$arch" "$cache") || exit 1
    PATH="$ruby_bin:$PATH"
    RUBY_DLL_PATH=$(cygpath -w "$(cygpath -u "${MINGW_PREFIX:-/ucrt64}")/bin")
    export PATH RUBY_DLL_PATH
    ;;
esac
[ -f vendor/love/src/common/version.h ] || git submodule update --init vendor/love || exit 1
bundle config set --local path vendor/bundle || exit 1
bundle check > /dev/null 2>&1 || bundle install --quiet || exit 1
exec bundle exec ruby tasks/prepush.rb "$@"
