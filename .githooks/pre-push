#
# Runs rake prepush and rake red_before_green on what is being pushed
# (tasks/prepush.rb), or on Windows Lota's Windows checks when the push
# can change Lota there. bin/setup writes a stub into the clone's hooks
# folder that runs this file. git passes the refs on standard input,
# which the Ruby reads. On Windows it runs without Bundler, whose bundle
# RubyInstaller's Ruby cannot build (doc/contributors/windows.md), since
# tasks/prepush.rb needs only Ruby's standard library.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*) exec ruby tasks/prepush.rb "$@" ;;
  *) exec bundle exec ruby tasks/prepush.rb "$@" ;;
esac
