#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 setdef <kerrick@setdef.com>
# SPDX-License-Identifier: AGPL-3.0-or-later

set -euo pipefail
IFS=$'\n\t'
set -vx

# LÖVE's Linux dependencies and the display the tests run on are system
# packages (tasks/apt/build.txt, which CI installs from too). Report the
# missing ones with the command that installs them; never run sudo here.
if [ "$(uname -s)" = Linux ] && command -v apt-get >/dev/null 2>&1 && command -v dpkg-query >/dev/null 2>&1; then
  missing="$(bin/apt-packages missing build | tr '\n' ' ')"
  if [ -n "$missing" ]; then
    {
      echo "These Ubuntu packages are missing: $missing"
      echo "Install them, then run bin/setup again:"
      echo "  sudo apt-get install --assume-yes $missing"
    } >&2
    exit 1
  fi
fi

if command -v mise >/dev/null 2>&1; then
  # vendor/love and vendor/love-apple-dependencies, which the engine builds from
  git submodule update --init
  # Rust and the Ruby mise compiles with it, CMake, Ninja, clang-format,
  # clang-tidy, and the REUSE tool, pinned in mise.toml
  mise install
  mise x -- bundle install
  # the source archives the precompiled gem carries (ext/lota/licenses.rb)
  mise x -- bundle exec rake sources:fetch
  # A CI runner or a build machine (CI=true) runs the checks alone: it
  # commits nothing and reads no documentation.
  if [ "${CI:-}" != true ]; then
    pre-commit install
  fi
  # The pre-push hook, .githooks/pre-push, runs from whichever worktree
  # pushes. The clone's shared hooks folder gets a stub that hands off to
  # it, so every worktree has the hook, and pre-commit (which refuses to
  # install under core.hooksPath) and any global hook that dispatches to
  # .git/hooks keep working. Writing the stub again changes nothing.
  hooks="$(git rev-parse --path-format=absolute --git-common-dir)/hooks"
  stub="$hooks/pre-push"
  if [ -e "$stub" ] && ! grep -q "lota pre-push stub" "$stub"; then
    echo "$stub exists and is not Lota's; leaving it, so the pre-push checks will not run." >&2
  else
    mkdir -p "$hooks"
    cat > "$stub" <<'STUB'
#!/bin/sh
# lota pre-push stub, written by bin/setup
hook="$(git rev-parse --show-toplevel)/.githooks/pre-push"
[ -x "$hook" ] || exit 0
exec "$hook" "$@"
STUB
    chmod +x "$stub"
    echo "Git hooks: $stub runs .githooks/pre-push, so git push runs rake prepush and red_before_green first."
  fi
  if [ "${CI:-}" != true ]; then
    bundle exec rake rdoc
  fi
else
  echo "mise isn't installed. Please install it to continue." >&2
  exit 1
fi
